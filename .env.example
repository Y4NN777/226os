# 226os environment template (ADR-0006). Copy to .env.<profile> and fill in; real secrets never
# go in Git, Compose files or images (.env and .env.* are git-ignored except this file).
#   cp .env.example .env.local-dev      then set APP_ENV=local-dev and generated passwords
# scripts/compose-env-guard.sh refuses to start a profile whose APP_ENV differs, and refuses any
# CHANGE_ME left in staging-test / production-live files.

# Must equal the Compose profile: local-dev | staging-test | production-live
APP_ENV=local-dev

# Images. Local builds use these defaults; deployed profiles set the digest built from the tested
# SHA (ghcr.io/<owner>/<image>@sha256:...), never a mutable tag.
API_IMAGE=226os-api:dev
WEB_IMAGE=226os-web:dev
MIGRATE_IMAGE=226os-migrate:dev

# PostgreSQL 18 (private network only, never published). Generate the password, e.g.:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
POSTGRES_USER=app226
POSTGRES_DB=app226
POSTGRES_PASSWORD=CHANGE_ME
# Used by migrate and, later, by the API. The host is always the Compose service `postgres`.
# Keep the password identical to POSTGRES_PASSWORD (URL-safe characters only).
DATABASE_URL=postgres://app226:CHANGE_ME@postgres:5432/app226?sslmode=disable

# HMAC key that signs pagination cursors (ADR-0004 point 5): at least 32 random bytes, base64.
# Generate it, e.g.: openssl rand -base64 32
CURSOR_KEY=CHANGE_ME

# Outgoing mail (all optional; leave empty to run without mail). The API refuses a half-set group.
#   local-dev:      SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_TLS=none  SMTP_FROM=no-reply@226os.local
#                   (the mailpit service catches everything; UI at http://127.0.0.1:8025)
#   staging-test and production-live: Gmail SMTP with an app password, STARTTLS on 587:
#                   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=starttls
#                   SMTP_USERNAME=<the sending Gmail address>  SMTP_PASSWORD=<the Gmail APP password, H8>
#                   SMTP_FROM=<the same address>
# The app password lives ONLY in the staging and production env files, never in Git. SMTP_TLS=none
# (cleartext) is refused outside local-dev.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=

# Public origin that the verification and reset mails link to (optional): an absolute http or https origin with no
# path, query or fragment; https is required in staging-test and production-live. The link carries the token in the
# URL fragment (<origin>/verifier-email#token=..., <origin>/reinitialiser#token=...) and the mail still shows the
# bare code. Empty keeps today's behaviour: the mail holds the bare code only.
#   local-dev:      APP_BASE_URL=http://127.0.0.1:8088   (the Traefik edge at HTTP_BIND:HTTP_PORT)
#   staging-test and production-live: APP_BASE_URL=https://<PUBLIC_HOST>
APP_BASE_URL=

# Assistant (S9, Google AI Studio, Gemma 4; free tier decided 2026-11-12). Off by default. To enable it set
# AI_ENABLED=true plus AI_API_KEY (a secret: only in the profile's env file) and AI_MODEL; there is no default
# model. List the model ids your key can use with `go run ./src/api/cmd/aicheck models`.
# Staging uses gemma-4-26b-a4b-it. AI_TIMEOUT is optional (a duration between 1s and 120s).
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=

# Edge (Traefik, the only public service). local-dev: plain HTTP bound to loopback.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# staging-test / production-live only: public host name, ACME contact, and ACME CA
# (default is Let's Encrypt production; use the staging CA URL while testing DNS).
PUBLIC_HOST=
ACME_EMAIL=
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Gated migration (staging-test / production-live only): set both on the command line for one run,
# never persist them here. See scripts/migrate-up.sh.
# MIGRATE_CONFIRM=<profile>
# BACKUP_EVIDENCE=<path to a non-empty file recording the backup>
