# 226os environment template (ADR-0006). Copy to .env.<profile> and fill in; real secrets never
# go in Git, Compose files or images (.env and .env.* are git-ignored except this file).
#   cp .env.example .env.local-dev      then set APP_ENV=local-dev and generated passwords
# scripts/compose-env-guard.sh refuses to start a profile whose APP_ENV differs, and refuses any
# CHANGE_ME left in staging-test / production-live files.

# Must equal the Compose profile: local-dev | staging-test | production-live
APP_ENV=local-dev

# Images. Local builds use these defaults; deployed profiles set the digest built from the tested
# SHA (ghcr.io/<owner>/<image>@sha256:...), never a mutable tag.
API_IMAGE=226os-api:dev
WEB_IMAGE=226os-web:dev
MIGRATE_IMAGE=226os-migrate:dev

# PostgreSQL 18 (private network only, never published). Generate the password, e.g.:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
POSTGRES_USER=app226
POSTGRES_DB=app226
POSTGRES_PASSWORD=CHANGE_ME
# Used by migrate and, later, by the API. The host is always the Compose service `postgres`.
# Keep the password identical to POSTGRES_PASSWORD (URL-safe characters only).
DATABASE_URL=postgres://app226:CHANGE_ME@postgres:5432/app226?sslmode=disable

# Edge (Traefik, the only public service). local-dev: plain HTTP bound to loopback.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
# staging-test / production-live only: public host name, ACME contact, and ACME CA
# (default is Let's Encrypt production; use the staging CA URL while testing DNS).
PUBLIC_HOST=
ACME_EMAIL=
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Gated migration (staging-test / production-live only): set both on the command line for one run,
# never persist them here. See scripts/migrate-up.sh.
# MIGRATE_CONFIRM=<profile>
# BACKUP_EVIDENCE=<path to a non-empty file recording the backup>
