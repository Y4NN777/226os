{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.local-dev)",
      "Read(**/.env.staging-test)",
      "Read(**/.env.production-live)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.prod)",
      "Read(**/.env.preview)",
      "Read(**/.env.ci)",
      "Read(**/.env.dev)",
      "Read(**/.env.stage)",
      "Read(**/.env.qa)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(**/.env.old)",
      "Read(**/.env.docker)",
      "Read(**/.env.compose)",
      "Read(**/.env.*.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/*.secret)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.local-dev)",
      "Edit(**/.env.staging-test)",
      "Edit(**/.env.production-live)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.ci)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.stage)",
      "Edit(**/.env.qa)",
      "Edit(**/.env.secret)",
      "Edit(**/.env.secrets)",
      "Edit(**/.env.backup)",
      "Edit(**/.env.bak)",
      "Edit(**/.env.old)",
      "Edit(**/.env.docker)",
      "Edit(**/.env.compose)",
      "Edit(**/.env.*.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/domain_skills.py pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/domain_skills.py post-skill",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/domain_skills.py session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
